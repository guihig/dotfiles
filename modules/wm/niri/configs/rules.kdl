window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"# title=r#"^Extension\:.*Bitwarden.*$"#
    open-floating true
    default-column-width { fixed 440; }
    default-window-height { fixed 690; }
}

window-rule {
    match title="Bitwarden"
    open-floating true
    default-column-width { fixed 440; }
    default-window-height { fixed 690; }
}

window-rule {
    match app-id=r#"org.quickshell$"#
    match app-id=r#"com.danklinux.dms$"#
    open-floating true
}

window-rule {
    match app-id=r#"^steam_app_(default|[0-9]+)|gamescope|steam|steamwebhelper$"#
    open-on-workspace "5"
}

// Exiled Exchange 2's PoE overlay expects to float on top of the game as a
// transparent, click-through window - niri tiles it like any other window
// by default, which also steals focus from the game on open. Pinned to the
// same workspace as PoE2 (see the steam_app rule above) since it otherwise
// opens on whatever workspace was active at launch, not necessarily where
// the game lives.
window-rule {
    match app-id=r#"^exiled-exchange-2$"#
    open-floating true
    open-focused false
    open-on-workspace "top-2"
}
